# --- Ports exposed on the host ---
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5432

# --- PostgreSQL (local demo defaults, change for any real deployment) ---
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk
POSTGRES_DB=helpdesk

# Used by api when running outside docker (pnpm dev). Inside compose it is built from the vars above.
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk
# Integration tests (pnpm db:test:up starts this database on port 5433)
TEST_DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5433/helpdesk_test

# --- api ---
NODE_ENV=production
# Secure cookies require HTTPS; keep false for http://localhost
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
ATTACHMENTS_DIR=/data/attachments
# Run the background worker inside this api process
WORKER_ENABLED=true
# Seed the database on first start when it is empty
SEED_ON_START=true
SEED_TICKETS=20000

# --- Demo account passwords used by the seed (demo only) ---
SEED_CUSTOMER_PASSWORD=customer123
SEED_AGENT_PASSWORD=agent123
SEED_LEAD_PASSWORD=lead123

# --- web ---
# Where the Next.js server proxies /api/* to (inside compose: http://api:4000)
API_INTERNAL_URL=http://localhost:4000
