# --- Ports exposed on the host ---
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5432

# --- PostgreSQL ---
# !! helpdesk/helpdesk and the seed passwords below are PUBLIC demo defaults. Change them before
# exposing this stack to anything but your own machine. Postgres and the api are published on
# 127.0.0.1 only; the web port is the only one reachable from the network.
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk
POSTGRES_DB=helpdesk

# Used by api when running outside docker (pnpm dev). Inside compose it is built from the vars above.
# (keep the password in sync with POSTGRES_PASSWORD)
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk
# Integration tests (pnpm db:test:up starts this database on port 5433)
TEST_DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5433/helpdesk_test

# --- api ---
NODE_ENV=production
# Secure cookies require HTTPS; keep false for http://localhost
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Which hops may set X-Forwarded-For (express 'trust proxy'); the web proxy is a private-network hop
TRUST_PROXY=loopback, linklocal, uniquelocal
# Pool size: DATABASE_POOL_MAX + 3 must stay below postgres max_connections (100)
DATABASE_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=10000
# Failed logins per (email, ip) per 15 min before 429
LOGIN_MAX_FAILURES=5
RATE_LIMITS_ENABLED=true
# e2e only: ENABLE_TEST_HOOKS=true exposes POST /__test/* (CI appends it); never in production
ATTACHMENTS_DIR=/data/attachments
# Run the background worker inside this api process
WORKER_ENABLED=true
# Seed the database on first start when it is empty
SEED_ON_START=true
SEED_TICKETS=20000

# --- Demo account passwords used by the seed (demo only) ---
SEED_CUSTOMER_PASSWORD=customer123
SEED_AGENT_PASSWORD=agent123
SEED_LEAD_PASSWORD=lead123
# Optional comma-separated local holiday dates (YYYY-MM-DD) skipped by SLA timers
SLA_HOLIDAYS=

# --- web ---
# Where the Next.js server proxies /api/* to (inside compose: http://api:4000)
API_INTERNAL_URL=http://localhost:4000
